{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/api"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/dist/spa/index.html"
    }
  ],
  "builds": [
    {
      "src": "backend/api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/dist/spa/**",
      "use": "@vercel/static"
    }
  ]
}